<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tech.w3ll.egameleague.controllers.HistoricoController">
    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #212432; -fx-padding: 10;">
            <Label text="Estatísticas do Campeonato" textFill="#6272a4">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
        </HBox>
    </top>
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="200.0" spacing="20" style="-fx-background-color: #282a36; -fx-padding: 20;">
            <Label text="USUÁRIO:" textFill="#95a2cd">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <Label text="JOGADOR" textFill="#6272a4">
                <font>
                    <Font name="Arial Black" size="16.0" />
                </font>
            </Label>
            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="botaoInicio" mnemonicParsing="false" prefWidth="150.0" style="-fx-background-color: #44475a;" text="Início" textFill="#6272a4" onAction="#irParaInicio">
                <font>
                    <Font name="Arial Black" size="12.0" />
                </font></Button>
            <Button fx:id="botaoCriarT" mnemonicParsing="false" prefWidth="150.0" style="-fx-background-color: #44475a;" text="Criar Torneio" textFill="#6272a4" onAction="#abrirTelaCriarTorneio">
                <font>
                    <Font name="Arial Black" size="12.0" />
                </font></Button>
            <Button fx:id="botaoEspectarT" mnemonicParsing="false" prefWidth="150.0" style="-fx-background-color: #44475a;" text="Espectar Torneio" textFill="#6272a4" onAction="#abrirTelaEspectarTorneio">
                <font>
                    <Font name="Arial Black" size="12.0" />
                </font></Button>
        </VBox>
    </left>
    <center>
        <VBox spacing="15" style="-fx-background-color: #44475a; -fx-padding: 20;" BorderPane.alignment="CENTER">
            <Label style="-fx-font: #0000;" text="E - GAME LEAGUE: HISTÓRICO" textFill="#6272a4">
                <font>
                    <Font name="Arial Black" size="24.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Label>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Filtrar por Jogo:" textFill="#6272a4">
                    <font>
                        <Font name="Arial Black" size="12.0" />
                    </font></Label>
                <ComboBox fx:id="cbJogoHistorico" promptText="Selecione um Jogo" onAction="#aplicarFiltroHistorico" />
                <Button onAction="#aplicarFiltroHistorico" text="Aplicar Filtro" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblUltimaAtualizacaoHistorico" text="Última atualização: --/--/---- --:--:--" textFill="#c0c0c0" />
            </HBox>

            <TableView fx:id="tabelaHistorico" style="-fx-background-color: #72789a;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDataHora" prefWidth="120" style="-fx-font: Arial;" text="Data/Hora" />
                    <TableColumn fx:id="colTipoEvento" prefWidth="80" text="Tipo" />
                    <TableColumn fx:id="colJogo" prefWidth="120" text="Jogo" />
                    <TableColumn fx:id="colPontos" prefWidth="80" text="Pontos" />
                    <TableColumn fx:id="colJogadores" prefWidth="250" style="fx-background-color: #6272a4;" text="Jogadores Envolvidos" />
                    <TableColumn fx:id="colPosicao" prefWidth="80" text="Posição" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>